// STM32 core driver IPC interface for STM32L4.

interface stm32-sys

// Common types for talking about pins:

enum Port {
    doc "A GPIO port name."

    case A
    case B
    case C
    case D
    case E
    case F
    case G
    case H
    case I
    case J
    case K

    rust-derive Copy Clone Debug
}

enum Function {
    doc "An alternate function index for a pin."

    case AF0
    case AF1
    case AF2
    case AF3
    case AF4
    case AF5
    case AF6
    case AF7

    case AF8
    case AF9
    case AF10
    case AF11
    case AF12
    case AF13
    case AF14
    case AF15

    rust-derive Copy Clone Debug
}

enum Pull {
    doc "Possible settings for pin pull resistors."

    case Up
    case Down

    rust-derive Copy Clone Debug
}

// Operations:

method set_pin_output {
    doc "Configures a pin into output mode."

    operation 0
    arg port Port
    arg pin u8
    auto-retry
}

method set_pins_output {
    doc "Configures a pin into output mode."

    operation 9
    arg port Port
    arg mask u16
    auto-retry
}

method set_pin_high {
    doc "Sets a pin's output state to high. This won't have any immediate \
         effect unless the pin is in output mode."

    operation 1
    arg port Port
    arg pin u8
    auto-retry
}

method set_pin_low {
    doc "Sets a pin's output state to low. This won't have any immediate \
         effect unless the pin is in output mode."

    operation 2
    arg port Port
    arg pin u8
    auto-retry
}

method toggle_pin {
    doc "Inverts a pin's output state. This won't have any immediate effect \
         unless the pin is in output mode."

    operation 3
    arg port Port
    arg pin u8
    auto-retry
}

method set_pin_alternate_mode {
    doc "Configures a pin into Alternate mode, selecting a specific alternate \
         function index."

    operation 4
    arg port Port
    arg pin u8
    arg function Function
    auto-retry
}

method set_pin_input {
    doc "Configures a pin into input mode."

    operation 6
    arg port Port
    arg pin u8
    auto-retry
}

method set_pin_analog {
    doc "Configures a pin into Analog mode, putting it in a high impedance \
            state."

    operation 11
    arg port Port
    arg pin u8
    auto-retry
}

method is_pin_high {
    doc "Senses the current level of a pin."

    operation 7
    arg port Port
    arg pin u8
    result bool
    auto-retry
}

method read_pins {
    doc "Senses the current level of pins on a port."

    operation 10
    arg port Port
    result u16
    auto-retry
}

method set_pin_pull {
    doc "Configures pull resistors on a pin."

    operation 8
    arg port Port
    arg pin u8
    arg pull Option<Pull>
    auto-retry
}

method enable_clock {
    doc "Enables the clock signal to a peripheral."

    operation 5
    arg peripheral PeripheralName
    auto-retry
}

method enter_reset {
    doc "Requests that the reset line to a peripheral be asserted."

    operation 12
    arg peripheral PeripheralName
    auto-retry
}

method leave_reset {
    doc "Requests that the reset line to a peripheral be deasserted."

    operation 13
    arg peripheral PeripheralName
    auto-retry
}

on-cfg hubris_chip {
    is STM32G031 {
        enum PeripheralName {
            doc "An enumeration of all RCC-controlled peripherals on the chip."
        
            case Usart2 0b10_10001
        
            rust-derive Copy Clone Debug
        }
    }
    is STM32L412 {
        enum PeripheralName {
            doc "An enumeration of all RCC-controlled peripherals on the chip."

            // Bitwise value is:
            // bits 4:0: bit index in control registers
            // bits 7:5: register index:
            //  000 AHB1ENR
            //  001 AHB2ENR
            //  010 AHB3ENR
            //  011 APB1ENR1
            //  100 APB1ENR2
            //  101 APB2ENR

            case Tim2 0b011_00000 // APB1ENR1 bit 0
            case Crs 0b011_11000 // APB1ENR1 bit 24
            case UsbFs 0b011_11010 // APB1ENR1 bit 26

            rust-derive Copy Clone Debug
        }
    }
    is STM32U575 {
        enum PeripheralName {
            doc "An enumeration of all RCC-controlled peripherals on the chip."

            // Bitwise value is:
            // bits 4:0: bit index in control registers
            // bits 7:5: register index:
            //  000 AHB1ENR
            //  001 AHB2ENR1
            //  010 AHB2ENR2
            //  011 AHB3ENR
            //  100 APB1ENR1
            //  101 APB1ENR2
            //  110 APB2ENR
            //  111 APB3ENR

            case UsbOtg 0b001_01110
            case Crs 0b100_11000

            rust-derive Copy Clone Debug
        }
    }
    is STM32H7 {
        enum PeripheralName {
            doc "An enumeration of all RCC-controlled peripherals on the chip."

            // Bitwise value is:
            // bits 4:0: bit index in control registers
            // bits 8:5: register index:
            //  0000 AHB1ENR
            //  0001 AHB2ENR
            //  0010 AHB3ENR
            //  0011 AHB4ENR
            //  0100 APB1LENR
            //  0101 APB1HENR
            //  0110 APB2ENR
            //  0111 APB3ENR
            //  1000 APB4ENR

            case Dma1 0b0000_00000
            case Dma2 0b0000_00001
            case Usb1Otg 0b0000_11001
            case Usb2Otg 0b0000_11011

            case Tim2 0b0100_00000
            case Usart3 0b0100_10010

            case Dfsdm1 0b0110_11100

            rust-derive Copy Clone Debug
        }
    }
}
